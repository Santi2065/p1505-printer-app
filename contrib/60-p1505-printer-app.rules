# HP LaserJet P1505 (03f0:3f17): give the logged-in user access (uaccess) and
# group lp read/write. To print while logged out (e.g. shared to phones with
# `loginctl enable-linger`), add your user to the lp group.
SUBSYSTEM=="usb", ATTR{idVendor}=="03f0", ATTR{idProduct}=="3f17", MODE="0660", GROUP="lp", TAG+="uaccess"
